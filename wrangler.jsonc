{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "channel-one",
  "main": "src/relay/worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects are the ones available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // The web app (web/, React + shadcn/ui), served before the Worker runs.
  // Static assets are free and don't count as Worker requests.
  "assets": { "directory": "web/dist" },
  "build": { "command": "bun run web:build" },
  // No request logs: room ids and timing are nobody's business, and a closed
  // channel must leave nothing behind.
  "observability": { "enabled": false }
}
