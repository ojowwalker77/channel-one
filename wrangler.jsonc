{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "channel-one",
  "main": "src/relay/worker.ts",
  "compatibility_date": "2026-10-01",
  // Channels by Kiwi Init lives at channels.kiwiinit.com; the workers.dev address keeps working
  // for clients that still use it.
  "routes": [{ "pattern": "channels.kiwiinit.com", "custom_domain": true }],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "CHANNELS", "class_name": "Channel" },
      { "name": "PEOPLE", "class_name": "Directory" }
    ]
  },
  // SQLite-backed Durable Objects are the ones available on the Workers Free plan.
  // v2 deleted every pre-rename test room (deleting a class deletes all of its storage).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "deleted_classes": ["Room"] },
    { "tag": "v3", "new_sqlite_classes": ["Channel"] },
    { "tag": "v4", "new_sqlite_classes": ["Directory"] }
  ],
  // The web app (web/, React), served before the Worker runs.
  // Static assets are free and don't count as Worker requests.
  // SPA fallback so /auth/callback loads the app; API routes always reach the Worker.
  "assets": { "directory": "web/dist", "not_found_handling": "single-page-application", "run_worker_first": ["/v1/*"] },
  // Humans sign in with WorkOS AuthKit (production environment). Public values: no secret lives on the relay.
  "vars": {
    "WORKOS_CLIENT_ID": "client_01M4ECYXMZT31ZKEEZ9X66ZBN8",
    "WORKOS_AUTHKIT_DOMAIN": "https://possible-pleasure-97.authkit.app",
    // Private beta: only people on KIWI_BETA_USERS (WorkOS user ids, emails or "@domain",
    // comma-separated) create channels; anyone can still ask to join one. The list is a secret,
    // not a var, so it never lands in this public repo: `wrangler secret put KIWI_BETA_USERS`.
    // Where people who aren't on it can ask for access (empty: no link in the message).
    "KIWI_BETA_WAITLIST_URL": "",
    // The future free tier. Each is off when unset (self-hosted relays leave them out).
    // Channels one person owns at once; closing one frees the slot.
    "KIWI_QUOTA_CHANNELS_PER_OWNER": "2",
    // Active members per channel, people and agents together.
    "KIWI_QUOTA_MEMBERS_PER_CHANNEL": "8",
    // Messages stored per channel per UTC day; the refusal says when it resets.
    "KIWI_QUOTA_MESSAGES_PER_DAY": "2000",
    // Stored ciphertext per channel (50 MB); the oldest messages make room. Every relay caps
    // this at 1 GB when unset.
    "KIWI_QUOTA_BYTES_PER_CHANNEL": "52428800",
    // A channel with no new message and nobody connected for this many days is deleted,
    // exactly like a close.
    "KIWI_EXPIRE_AFTER_DAYS": "90"
  },
  "build": { "command": "bun run web:build" },
  // No request logs: room ids and timing are nobody's business, and a closed
  // channel must leave nothing behind.
  "observability": { "enabled": false }
}
