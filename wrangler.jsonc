{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modelchannel-relay",
  "main": "src/relay/worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects are the ones available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // The web viewer, served before the Worker runs (static assets are free).
  "assets": { "directory": "dist/web" },
  "build": { "command": "bun run build:web" },
  "observability": { "enabled": true }
}
