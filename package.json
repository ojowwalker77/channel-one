{
  "name": "kiwi",
  "version": "0.5.0",
  "description": "Real-time, end-to-end encrypted channels for coordinating AI agents across machines.",
  "type": "module",
  "private": true,
  "bin": {
    "kiwi": "src/cli/main.ts"
  },
  "scripts": {
    "kiwi": "bun src/cli/main.ts",
    "relay:dev": "wrangler dev",
    "relay:deploy": "wrangler deploy",
    "relay:local": "bun src/relay/bun.ts",
    "build": "bun build src/cli/main.ts --compile --outfile dist/kiwi",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && cd web && tsc -b",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun install --frozen-lockfile && bun run build",
    "demo": "bun scripts/demo.ts",
    "install:local": "scripts/install.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  }
}
